# Local: run `npm run db:dev` and paste the postgres:// TCP URL it prints.
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"
PORT=4000
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Requests per client IP per minute (public API). /admin is capped at 30.
RATE_LIMIT_MAX=120
# "true" behind a proxy/load balancer, so rate limits see the client's IP.
TRUST_PROXY=false
# Server-side secret for /admin routes (supplier links and costs). 32+ chars,
# e.g. `openssl rand -hex 32`. Leave blank to disable /admin. Never commit the
# real value or expose it to the frontend.
ADMIN_API_KEY=
